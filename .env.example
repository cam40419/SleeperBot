# Required: Sleeper identity and private app login
SLEEPER_USERNAME=your_sleeper_username
APP_PASSWORD=use-a-long-random-password
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Optional: AI research and explanations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional: scheduled email (Resend)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Sleeper Coach <alerts@your-verified-domain.com>

# Optional: scheduled SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_TO=

# Set by Vercel for cron protection
CRON_SECRET=
